# The Circle's watcher. Copy this to .env on the VPS and fill it in.
# The filled-in .env is git-ignored and must stay that way.

# --- Where to post what it finds -------------------------------------------------------
# The same two values the website already ships in config.js. The key is the publishable one;
# it is meant to be public and grants nothing on its own.
CIRCLE_URL=https://cdkopyphjvfxjqhasrae.supabase.co
CIRCLE_KEY=sb_publishable_9th0PfSraqrnnD5cTcQqxA_oqH6bwqn

# The robot account, made in Settings like anybody else but with "This is a robot" ticked and
# no roles at all. If this file were ever read by somebody else, that password could post a deal
# and read what any member reads. It cannot mint a point, move money, or change the catalog.
CIRCLE_USER=watcher
CIRCLE_PASS=

# An address RedWeek could write to if it wanted the watcher to stop. Optional, and it is sent
# to them on every request, so put one in only if you are happy for them to have it.
WATCH_CONTACT=

# --- Interval ---------------------------------------------------------------------------
# Victor's own account, on Victor's own machine. Leave blank to skip Interval entirely.
INTERVAL_USER=
INTERVAL_PASS=
# Filled in from the first --dump run. Until then Interval is skipped and RedWeek still runs.
INTERVAL_SEARCH_PATH=
INTERVAL_SEARCH_FIELDS=
# Off unless this says on. Victor's call, 8 September 2026: on. A refused sign-in doubles the
# wait before the next attempt — 1 h, 2 h, 4 h … up to WATCH_INTERVAL_RETRY_MAX_MIN — and a
# sign-in that works puts it back to every pass. RedWeek runs every pass whatever Interval says.
WATCH_INTERVAL=on
WATCH_INTERVAL_RETRY_MAX_MIN=1440
# The next fortnight is asked for on its own, before the long window, so a Getaway that starts
# today or this week is never lost off the end of a four-month results page.
WATCH_INTERVAL_SOON_DAYS=14

# --- What counts as worth telling people about -------------------------------------------
# Interval: every Getaway week at a place in the catalog is posted, whatever it costs.
# RedWeek: an owner's week is posted when it undercuts the resort's PUBLIC rate (the catalog's
# "public rate" field) by WATCH_BEAT_BY_PCT, and only the cheapest WATCH_MAX_PER_RESORT_MONTH per
# resort per check-in month. Nothing at a resort the catalog does not carry can be posted at all.
WATCH_EVERY_MIN=30            # how often to look
WATCH_MUST_BEAT_OURS=true     # RedWeek only: post what undercuts the public rate
WATCH_BEAT_BY_PCT=15          # and by at least this much
WATCH_MAX_PER_RESORT_MONTH=3  # the cheapest few owner weeks per resort per month; 0 = no cap
WATCH_ONLY_OUR_STAYS=true     # narrows the RedWeek sweep to catalog resorts (posting always needs one)
WATCH_MIN_NIGHTS=0
WATCH_MAX_NIGHTLY_USD=0       # 0 = no ceiling
WATCH_WINDOW_DAYS=120         # how far ahead to search Interval
WATCH_GUESTS=2
